          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "base",
        "column",
        "row"
      ],
      "type": "object"
    },
    "CoordinateOrigin": {
      "description": "Coordinate-system origin for rectangular source regions.",
      "enum": [
        "top_left",
        "bottom_left"
      ],
      "type": "string"
    },
    "CoordinateUnit": {
      "description": "Units used by rectangular source regions.",
      "enum": [
        "points",
        "pixels",
        "normalized"
      ],
      "type": "string"
    },
