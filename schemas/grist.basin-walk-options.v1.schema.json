{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "description": "Walk extraction parameters. Defaults mirror the research harness.",
  "properties": {
    "max_depth": {
      "default": 6,
      "format": "uint",
      "minimum": 0.0,
      "type": "integer"
    },
    "max_walks": {
      "default": 40,
      "format": "uint",
      "minimum": 0.0,
      "type": "integer"
    }
  },
  "title": "WalkOptions",
  "type": "object"
}
