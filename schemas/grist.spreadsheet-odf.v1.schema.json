              "type": "string"
            }
          },
          "required": [
            "index",
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "header": {
              "type": [
                "string",
                "null"
              ]
            },
            "message_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "mime_path": {
              "items": {
                "$ref": "#/definitions/IndexPosition"
              },
              "type": "array"
            },
            "type": {
              "enum": [
                "email_part"
              ],
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "member_index": {
              "$ref": "#/definitions/IndexPosition"
            },
            "member_path": {
              "type": "string"
            },
            "type": {
              "enum": [
                "archive_member"
              ],
