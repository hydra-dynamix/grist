    "LocatorConfidence": {
      "format": "double",
      "maximum": 1.0,
      "minimum": 0.0,
      "type": "number"
    },
    "ParserAvailability": {
      "description": "Whether a ranked candidate can be interpreted by the active registry.",
      "enum": [
        "available",
        "unavailable",
        "unregistered"
      ],
      "type": "string"
    },
    "RawContentIdentity": {
      "description": "SHA-256 of exactly the original input bytes, without a prefix or suffix.",
      "properties": {
        "byte_length": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "sha256": {
          "type": "string"
        }
      },
      "required": [
        "byte_length",
        "sha256"
      ],
      "type": "object"
    },
    "SchemaVersion": {
      "type": "string"
    },
    "SourceLocator": {
      "description": "An outermost-to-innermost containment chain.\n\nComponent `n` is interpreted relative to component `n - 1`. For example, `[archive_member, email_part, ooxml_part, text_range]` identifies text in an OOXML part attached to an email stored in an archive without flattening any parent coordinate system.",
      "oneOf": [
        {
          "properties": {
            "derived_from": {
              "anyOf": [
                {
                  "$ref": "#/definitions/DerivedNodeReference"
                },
                {
                  "type": "null"
                }
              ]
            },
            "precision": {
              "enum": [
                "exact"
              ],
              "type": "string"
            }
          },
          "required": [
            "precision"
          ],
          "type": "object"
        },
        {
          "properties": {
            "confidence": {
              "$ref": "#/definitions/LocatorConfidence"
            },
            "derived_from": {
              "anyOf": [
                {
                  "$ref": "#/definitions/DerivedNodeReference"
                },
                {
                  "type": "null"
                }
              ]
            },
            "precision": {
              "enum": [
                "approximate"
              ],
              "type": "string"
            }
          },
          "required": [
            "confidence",
            "precision"
          ],
          "type": "object"
        },
        {
          "properties": {
            "confidence": {
              "anyOf": [
                {
                  "$ref": "#/definitions/LocatorConfidence"
                },
                {
                  "type": "null"
                }
              ]
            },
            "derived_from": {
              "$ref": "#/definitions/DerivedNodeReference"
            },
            "precision": {
              "enum": [
                "synthetic"
              ],
              "type": "string"
            }
          },
          "required": [
            "derived_from",
            "precision"
          ],
          "type": "object"
        }
      ],
      "properties": {
        "components": {
          "items": {
            "$ref": "#/definitions/LocationComponent"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "components"
      ],
      "type": "object"
    },
    "SpreadsheetOdfCachedValue": {
      "properties": {
        "displayed_value": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "$ref": "#/definitions/SpreadsheetOdfCachedValueSource"
        },
        "stored_value": {
          "type": "string"
        },
        "value_type": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "source",
        "stored_value"
      ],
      "type": "object"
    },
    "SpreadsheetOdfCachedValueSource": {
      "enum": [
        "package_stored_formula_result"
      ],
      "type": "string"
    },
