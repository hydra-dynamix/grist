            }
          },
          "required": [
            "member_index",
            "member_path",
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "bbox": {
              "anyOf": [
                {
                  "$ref": "#/definitions/BoundingBox"
                },
                {
                  "type": "null"
                }
              ]
            },
            "frame": {
              "$ref": "#/definitions/IndexPosition"
            },
            "type": {
              "enum": [
                "image_region"
              ],
              "type": "string"
            }
          },
          "required": [
            "frame",
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "end_ms": {
              "format": "uint64",
              "minimum": 0.0,
              "type": "integer"
            },
            "start_ms": {
              "format": "uint64",
              "minimum": 0.0,
              "type": "integer"
            },
            "track": {
              "anyOf": [
                {
                  "$ref": "#/definitions/IndexPosition"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": {
              "enum": [
                "media_time"
              ],
              "type": "string"
            }
          },
          "required": [
            "end_ms",
            "start_ms",
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "collection": {
              "type": "string"
            },
            "field": {
              "type": [
                "string",
                "null"
              ]
            },
            "records": {
              "$ref": "#/definitions/IndexRange"
            },
            "type": {
              "enum": [
                "record_range"
              ],
              "type": "string"
            }
          },
          "required": [
            "collection",
            "records",
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "pointer": {
              "type": "string"
