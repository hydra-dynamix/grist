{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "AggregateContentIdentity": {
      "description": "Content identity for a compound input.\n\nMembers are sorted by member index, then path and identity fields. `sha256` hashes canonical JSON v1 of `schema_version`, `canonicalization`, and the sorted `members` array. Summary fields and the digest itself are excluded.",
      "properties": {
        "canonicalization": {
          "$ref": "#/definitions/CanonicalJsonVersion"
        },
        "manifest_byte_length": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "member_count": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "members": {
          "items": {
            "$ref": "#/definitions/AggregateMemberIdentity"
          },
          "type": "array"
        },
        "schema_version": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        },
        "total_byte_length": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "canonicalization",
        "manifest_byte_length",
        "member_count",
        "members",
        "schema_version",
        "sha256",
        "total_byte_length"
      ],
      "type": "object"
    },
    "AggregateMemberIdentity": {
      "description": "Stable member summary used in a compound-input aggregate manifest.",
      "properties": {
        "aggregate_sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "byte_length": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "canonical_payload_sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "decoded_sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "format": {
          "anyOf": [
            {
              "$ref": "#/definitions/FormatIdentity"
            },
            {
              "type": "null"
            }
          ]
        },
        "member_index": {
          "format": "uint64",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "member_path": {
          "type": "string"
        },
        "raw_sha256": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "byte_length",
        "member_path"
      ],
      "type": "object"
    },
    "BomKind": {
      "enum": [
        "utf8",
        "utf16_le",
        "utf16_be",
        "utf32_le",
        "utf32_be"
      ],
      "type": "string"
    },
    "BoundingBox": {
      "description": "A rectangle in a declared coordinate system.",
      "properties": {
        "height": {
          "format": "double",
          "type": "number"
        },
        "origin": {
          "$ref": "#/definitions/CoordinateOrigin"
        },
        "unit": {
          "$ref": "#/definitions/CoordinateUnit"
        },
        "width": {
          "format": "double",
          "type": "number"
        },
        "x": {
          "format": "double",
          "type": "number"
        },
        "y": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "height",
        "origin",
        "unit",
        "width",
        "x",
        "y"
      ],
      "type": "object"
    },
    "CanonicalJsonVersion": {
      "description": "Canonical JSON compatibility boundary.\n\nNew algorithms require new enum variants. Changing `V1` would change payload and aggregate identities and is an incompatible change.",
      "enum": [
        "grist/canonical-json/v1"
      ],
      "type": "string"
    },
    "CanonicalPayloadIdentity": {
      "description": "SHA-256 of the exact canonical JSON bytes of an authoritative payload.",
      "properties": {
        "byte_length": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "canonicalization": {
          "$ref": "#/definitions/CanonicalJsonVersion"
        },
        "payload_schema_version": {
          "$ref": "#/definitions/SchemaVersion"
        },
        "sha256": {
          "type": "string"
        }
      },
      "required": [
        "byte_length",
        "canonicalization",
        "payload_schema_version",
        "sha256"
      ],
      "type": "object"
    },
    "CellAddress": {
      "description": "A sheet cell address with explicit row and column bases.",
      "properties": {
        "base": {
          "$ref": "#/definitions/IndexBase"
        },
        "column": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "row": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "base",
        "column",
        "row"
      ],
      "type": "object"
    },
    "ContentIdentity": {
      "description": "Complete singular or compound content identity retained by an envelope.",
      "properties": {
        "aggregate": {
          "anyOf": [
            {
              "$ref": "#/definitions/AggregateContentIdentity"
            },
            {
              "type": "null"
            }
          ]
        },
        "canonical_payload": {
          "anyOf": [
            {
              "$ref": "#/definitions/CanonicalPayloadIdentity"
            },
            {
              "type": "null"
            }
          ]
        },
        "decoded": {
          "anyOf": [
            {
              "$ref": "#/definitions/DecodedContentIdentity"
            },
            {
              "type": "null"
            }
          ]
        },
        "detection_candidates": {
          "default": [],
          "items": {
            "$ref": "#/definitions/DetectionCandidate"
          },
          "type": "array"
        },
        "format": {
          "anyOf": [
            {
              "$ref": "#/definitions/FormatIdentity"
            },
            {
              "type": "null"
            }
          ]
        },
        "raw": {
          "anyOf": [
            {
              "$ref": "#/definitions/RawContentIdentity"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "CoordinateOrigin": {
      "description": "Coordinate-system origin for rectangular source regions.",
      "enum": [
        "top_left",
        "bottom_left"
      ],
      "type": "string"
    },
    "CoordinateUnit": {
      "description": "Units used by rectangular source regions.",
      "enum": [
        "points",
        "pixels",
        "normalized"
      ],
      "type": "string"
    },
    "DecodeIssue": {
      "description": "A precise loss or conflict range in both available coordinate systems.",
      "properties": {
        "conflicting_raw_range": {
          "anyOf": [
            {
              "$ref": "#/definitions/RawByteRange"
            },
            {
              "type": "null"
            }
          ]
        },
        "decoded_range": {
          "anyOf": [
            {
              "$ref": "#/definitions/DecodedByteRange"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "$ref": "#/definitions/DecodeIssueKind"
        },
        "message": {
          "type": "string"
        },
        "raw_range": {
          "$ref": "#/definitions/RawByteRange"
        }
      },
      "required": [
        "kind",
        "message",
        "raw_range"
      ],
      "type": "object"
    },
    "DecodeIssueKind": {
      "enum": [
        "undecodable_sequence",
        "truncated_code_unit",
        "encoding_conflict",
        "unsupported_declaration"
      ],
      "type": "string"
    },
    "DecodeReport": {
      "description": "Serializable decoding evidence. Raw bytes remain on [`DecodedText`].",
      "properties": {
        "bom": {
          "anyOf": [
            {
              "$ref": "#/definitions/BomKind"
            },
            {
              "type": "null"
            }
          ]
        },
        "declarations": {
          "items": {
            "$ref": "#/definitions/EncodingDeclaration"
          },
          "type": "array"
        },
        "decoded_identity": {
          "$ref": "#/definitions/DecodedContentIdentity"
        },
        "diagnostics": {
          "items": {
            "$ref": "#/definitions/Diagnostic"
          },
          "type": "array"
        },
        "encoding": {
          "$ref": "#/definitions/TextEncoding"
        },
        "issues": {
          "items": {
            "$ref": "#/definitions/DecodeIssue"
          },
          "type": "array"
        },
        "newlines": {
          "$ref": "#/definitions/NewlineFidelity"
        },
        "raw_identity": {
          "$ref": "#/definitions/RawContentIdentity"
        },
        "schema_version": {
          "type": "string"
        }
      },
      "required": [
        "declarations",
        "decoded_identity",
        "diagnostics",
        "encoding",
        "issues",
        "newlines",
        "raw_identity",
        "schema_version"
      ],
      "type": "object"
    },
    "DecodedByteRange": {
      "description": "A zero-based half-open UTF-8 byte range in the decoded text.",
      "properties": {
        "end": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "start": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "end",
        "start"
      ],
      "type": "object"
    },
    "DecodedContentIdentity": {
      "description": "SHA-256 of decoded text's UTF-8 bytes, including replacements when lossy.\n\nEncoding, loss state, and diagnostics are metadata outside the hashed bytes.",
      "properties": {
        "byte_length": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "encoding": {
          "type": "string"
        },
        "lossy": {
          "type": "boolean"
        },
        "sha256": {
          "type": "string"
        }
      },
      "required": [
        "byte_length",
        "encoding",
        "lossy",
        "sha256"
      ],
      "type": "object"
    },
    "DerivedNodeReference": {
      "description": "A reference from derived content back to the nodes and declared transforms that produced it.",
      "properties": {
        "derivation_steps": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "source_node_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "derivation_steps",
        "source_node_ids"
      ],
      "type": "object"
    },
    "DetectionCandidate": {
      "description": "A ranked format candidate with all evidence retained.",
      "properties": {
        "confidence": {
          "format": "float",
          "type": "number"
        },
        "evidence": {
          "items": {
            "$ref": "#/definitions/DetectionEvidence"
          },
          "type": "array"
        },
        "identity": {
          "$ref": "#/definitions/FormatIdentity"
        },
        "parser_availability": {
          "allOf": [
            {
              "$ref": "#/definitions/ParserAvailability"
            }
          ],
          "default": "unregistered"
        },
        "parser_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "rank": {
          "description": "One-based rank; lower ranks are preferred.",
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "confidence",
        "evidence",
        "identity",
        "rank"
      ],
      "type": "object"
    },
    "DetectionEvidence": {
      "description": "One retained reason for a ranked detection candidate.",
      "properties": {
        "description": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/definitions/DetectionEvidenceKind"
        }
      },
      "required": [
        "description",
        "kind"
      ],
      "type": "object"
    },
    "DetectionEvidenceKind": {
      "description": "Signal family that contributed to a detection candidate.",
      "enum": [
        "magic_bytes",
        "declared_media_type",
        "extension",
        "filename",
        "container_manifest",
        "charset",
        "structure",
        "shebang",
        "grammar_probe",
        "fallback"
      ],
      "type": "string"
    },
    "Diagnostic": {
      "description": "A root-cause diagnostic with source attribution and structured causes.",
      "properties": {
        "affected_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "cause": {
          "default": [],
          "description": "Legacy flat causes retained for v1 wire compatibility.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "causes": {
          "default": [],
          "items": {
            "$ref": "#/definitions/DiagnosticCause"
          },
          "type": "array"
        },
        "class": {
          "allOf": [
            {
              "$ref": "#/definitions/DiagnosticClass"
            }
          ],
          "default": "unclassified"
        },
        "code": {
          "type": "string"
        },
        "details": true,
        "documentation_uri": {
          "type": [
            "string",
            "null"
          ]
        },
        "explanation_key": {
          "type": [
            "string",
            "null"
          ]
        },
        "locator": {
          "anyOf": [
            {
              "$ref": "#/definitions/SourceLocator"
            },
            {
              "type": "null"
            }
          ]
        },
        "message": {
          "type": "string"
        },
        "module": {
          "default": "",
          "type": "string"
        },
        "parser": {
          "type": "string"
        },
        "partial": {
          "default": false,
          "type": "boolean"
        },
        "range": {
          "anyOf": [
            {
              "$ref": "#/definitions/SourceRange"
            },
            {
              "type": "null"
            }
          ]
        },
        "recovery": {
          "anyOf": [
            {
              "$ref": "#/definitions/RecoveryAction"
            },
            {
              "type": "null"
            }
          ]
        },
        "severity": {
          "$ref": "#/definitions/Severity"
        },
        "source": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_identity": {
          "anyOf": [
            {
              "$ref": "#/definitions/ContentIdentity"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "code",
        "message",
        "parser",
        "severity"
      ],
      "type": "object"
    },
    "DiagnosticCause": {
      "description": "One nested reason beneath a diagnostic's root-cause message.",
      "properties": {
        "cause": {
          "anyOf": [
            {
              "$ref": "#/definitions/DiagnosticCause"
            },
            {
              "type": "null"
            }
          ]
        },
        "code": {
          "type": "string"
        },
        "details": true,
        "message": {
          "type": "string"
        },
        "module": {
          "type": [
            "string",
            "null"
          ]
        },
        "parser": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "code",
        "message"
      ],
      "type": "object"
    },
    "DiagnosticClass": {
      "description": "Stable top-level condition families shared by every parser and operation.",
      "enum": [
        "malformed_input",
        "unsupported_content",
        "lossy_normalization",
        "provider_failure",
        "parser_defect",
        "security_rejection",
        "resource_budget_exhaustion",
        "unclassified"
      ],
      "type": "string"
    },
    "EncodingDeclaration": {
      "description": "One retained piece of encoding evidence, whether selected or contradicted.",
      "properties": {
        "decoded_range": {
          "anyOf": [
            {
              "$ref": "#/definitions/DecodedByteRange"
            },
            {
              "type": "null"
            }
          ]
        },
        "encoding": {
          "anyOf": [
            {
              "$ref": "#/definitions/TextEncoding"
            },
            {
              "type": "null"
            }
          ]
        },
        "label": {
          "type": "string"
        },
        "raw_range": {
          "anyOf": [
            {
              "$ref": "#/definitions/RawByteRange"
            },
            {
              "type": "null"
            }
          ]
        },
        "selected": {
          "type": "boolean"
        },
        "source": {
          "$ref": "#/definitions/EncodingDeclarationSource"
        }
      },
      "required": [
        "label",
        "selected",
        "source"
      ],
      "type": "object"
    },
    "EncodingDeclarationSource": {
      "enum": [
        "byte_order_mark",
        "transport",
        "html_meta",
        "xml_declaration",
        "xml_signature",
        "heuristic",
        "default"
      ],
      "type": "string"
    },
    "FormatIdentity": {
      "description": "Detected parser-format name paired with an Internet media type when known.",
      "properties": {
        "format": {
          "type": "string"
        },
        "media_type": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "format"
      ],
      "type": "object"
    },
    "IncludeReference": {
      "properties": {
        "resolved": {
          "anyOf": [
            {
              "$ref": "#/definitions/ResolvedInclude"
            },
            {
              "type": "null"
            }
          ]
        },
        "resolved_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "$ref": "#/definitions/IncludeStatus"
        },
        "target": {
          "type": "string"
        }
      },
      "required": [
        "status",
        "target"
      ],
      "type": "object"
    },
    "IncludeStatus": {
      "enum": [
        "resolved",
        "reference_only",
        "remote_disabled",
        "outside_project_root",
        "missing",
        "not_file",
        "cycle",
        "depth_exceeded",
        "budget_exceeded",
        "decode_failed"
      ],
      "type": "string"
    },
    "IndexBase": {
      "description": "Whether an ordinal is counted from zero or one.\n\nEvery format component carrying a page, slide, cell, frame, token, output, member, track, or record ordinal uses this type rather than relying on an undocumented convention.",
      "enum": [
        "zero",
        "one"
      ],
      "type": "string"
    },
    "IndexPosition": {
      "description": "One explicitly based ordinal.",
      "properties": {
        "base": {
          "$ref": "#/definitions/IndexBase"
        },
        "value": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "base",
        "value"
      ],
      "type": "object"
    },
    "IndexRange": {
      "description": "A half-open range of ordinals using one declared base.",
      "properties": {
        "base": {
          "$ref": "#/definitions/IndexBase"
        },
        "end": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "start": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "base",
        "end",
        "start"
      ],
      "type": "object"
    },
    "LocationComponent": {
      "description": "One location inside its immediately preceding parent component.",
      "oneOf": [
        {
          "properties": {
            "byte_end": {
              "format": "uint",
              "minimum": 0.0,
              "type": "integer"
            },
            "byte_start": {
              "format": "uint",
              "minimum": 0.0,
              "type": "integer"
            },
            "end_column": {
              "format": "uint",
              "minimum": 0.0,
              "type": "integer"
            },
            "end_line": {
              "format": "uint",
              "minimum": 0.0,
              "type": "integer"
            },
            "start_column": {
              "format": "uint",
              "minimum": 0.0,
              "type": "integer"
            },
            "start_line": {
              "format": "uint",
              "minimum": 0.0,
              "type": "integer"
            },
            "type": {
              "enum": [
                "text_range"
              ],
              "type": "string"
            }
          },
          "required": [
            "byte_end",
            "byte_start",
            "end_column",
            "end_line",
            "start_column",
            "start_line",
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "bbox": {
              "anyOf": [
                {
                  "$ref": "#/definitions/BoundingBox"
                },
                {
                  "type": "null"
                }
              ]
            },
            "page": {
              "$ref": "#/definitions/IndexPosition"
            },
            "rotation_degrees": {
              "format": "int16",
              "type": [
                "integer",
                "null"
              ]
            },
            "tokens": {
              "anyOf": [
                {
                  "$ref": "#/definitions/IndexRange"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": {
              "enum": [
                "pdf_region"
              ],
              "type": "string"
            }
          },
          "required": [
            "page",
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "column": {
              "anyOf": [
                {
                  "$ref": "#/definitions/IndexPosition"
                },
                {
                  "type": "null"
                }
              ]
            },
            "object_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "paragraph": {
              "anyOf": [
                {
                  "$ref": "#/definitions/IndexPosition"
                },
                {
                  "type": "null"
                }
              ]
            },
            "part": {
              "type": "string"
            },
            "row": {
              "anyOf": [
                {
                  "$ref": "#/definitions/IndexPosition"
                },
                {
                  "type": "null"
                }
              ]
            },
            "run": {
              "anyOf": [
                {
                  "$ref": "#/definitions/IndexPosition"
                },
                {
                  "type": "null"
                }
              ]
            },
            "table": {
              "anyOf": [
                {
                  "$ref": "#/definitions/IndexPosition"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": {
              "enum": [
                "ooxml_part"
              ],
              "type": "string"
            }
          },
          "required": [
            "part",
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "bbox": {
              "anyOf": [
                {
                  "$ref": "#/definitions/BoundingBox"
                },
                {
                  "type": "null"
                }
              ]
            },
            "shape_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "slide": {
              "$ref": "#/definitions/IndexPosition"
            },
            "type": {
              "enum": [
                "slide_region"
              ],
              "type": "string"
            }
          },
          "required": [
            "slide",
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "end_cell": {
