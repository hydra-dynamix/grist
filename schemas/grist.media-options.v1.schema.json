{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "MediaTranscriptionOptions": {
      "additionalProperties": false,
      "properties": {
        "max_streams": {
          "default": 1000,
          "format": "uint64",
          "minimum": 1.0,
          "type": "integer"
        },
        "provider_options": {
          "allOf": [
            {
              "$ref": "#/definitions/TranscriptionOptions"
            }
          ],
          "default": {
            "language_hints": [],
            "speaker_diarization": false,
            "word_timestamps": false
          }
        },
        "reconcile": {
          "default": false,
          "type": "boolean"
        },
        "selection": {
          "allOf": [
            {
              "$ref": "#/definitions/MediaTranscriptionSelection"
            }
          ],
          "default": {
            "mode": "disabled"
          }
        }
      },
      "type": "object"
    },
    "MediaTranscriptionSelection": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "mode": {
              "enum": [
                "disabled"
              ],
              "type": "string"
            }
          },
          "required": [
            "mode"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "mode": {
              "enum": [
                "all_audio_streams"
              ],
              "type": "string"
            }
          },
          "required": [
            "mode"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "mode": {
              "enum": [
                "selected_audio_streams"
              ],
              "type": "string"
            },
            "stream_ids": {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "required": [
            "mode",
            "stream_ids"
          ],
          "type": "object"
        }
      ]
    },
    "TranscriptionOptions": {
      "properties": {
        "language_hints": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "speaker_diarization": {
          "default": false,
          "type": "boolean"
        },
        "track": {
          "type": [
            "string",
            "null"
          ]
        },
        "word_timestamps": {
          "default": false,
          "type": "boolean"
        }
      },
      "type": "object"
    }
  },
  "properties": {
    "max_attachment_bytes": {
      "default": 33554432,
      "format": "uint64",
      "minimum": 1.0,
      "type": "integer"
    },
    "max_boxes": {
      "default": 100000,
      "format": "uint64",
      "minimum": 1.0,
      "type": "integer"
    },
    "max_metadata_bytes": {
      "default": 16777216,
      "format": "uint64",
      "minimum": 1.0,
      "type": "integer"
    },
    "max_nesting_depth": {
      "default": 64,
      "format": "uint64",
      "minimum": 1.0,
      "type": "integer"
    },
    "max_subtitle_bytes": {
      "default": 16777216,
      "format": "uint64",
      "minimum": 1.0,
      "type": "integer"
    },
    "parse_embedded": {
      "default": true,
      "type": "boolean"
    },
    "retain_embedded_bytes": {
      "default": true,
      "type": "boolean"
    },
    "transcription": {
      "allOf": [
        {
          "$ref": "#/definitions/MediaTranscriptionOptions"
        }
      ],
      "default": {
        "max_streams": 1000,
        "provider_options": {
          "language_hints": [],
          "speaker_diarization": false,
          "word_timestamps": false
        },
        "reconcile": false,
        "selection": {
          "mode": "disabled"
        }
      }
    }
  },
  "title": "MediaOptions",
  "type": "object"
}
