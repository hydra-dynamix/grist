{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "SchemaDescriptor": {
      "description": "Complete registration metadata for one current public wire contract.",
      "properties": {
        "backend_sensitive": {
          "type": "boolean"
        },
        "canonical_example": {
          "type": "string"
        },
        "family": {
          "type": "string"
        },
        "file_name": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/definitions/SchemaKind"
        },
        "name": {
          "type": "string"
        },
        "schema_version": {
          "type": "string"
        }
      },
      "required": [
        "backend_sensitive",
        "canonical_example",
        "family",
        "file_name",
        "kind",
        "name",
        "schema_version"
      ],
      "type": "object"
    },
    "SchemaKind": {
      "enum": [
        "envelope",
        "payload",
        "graph",
        "segment",
        "event",
        "diagnostic",
        "options",
        "manifest",
        "contract"
      ],
      "type": "string"
    }
  },
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "schemas": {
      "items": {
        "$ref": "#/definitions/SchemaDescriptor"
      },
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "schemas"
  ],
  "title": "SchemaCatalog",
  "type": "object"
}
