{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "BudgetProfile": {
      "description": "Named, versioned policies. The version is part of the serialized variant.",
      "enum": [
        "untrusted_service_v1",
        "trusted_unbounded_v1"
      ],
      "type": "string"
    },
    "ResourceBudget": {
      "description": "All limits visible at every public operation boundary. `None` is explicitly unbounded.",
      "properties": {
        "max_archive_expansion_ratio": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "max_archive_members": {
          "format": "uint64",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "max_cells": {
          "format": "uint64",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "max_child_artifacts": {
          "format": "uint64",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "max_decoded_characters": {
          "format": "uint64",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "max_input_bytes": {
          "format": "uint64",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "max_memory_bytes": {
          "format": "uint64",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "max_nesting_depth": {
          "format": "uint64",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "max_nodes": {
          "format": "uint64",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "max_output_bytes": {
          "format": "uint64",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "max_pages": {
          "format": "uint64",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "max_parse_millis": {
          "format": "uint64",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "max_provider_millis": {
          "format": "uint64",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "max_records": {
          "format": "uint64",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "max_temporary_storage_bytes": {
          "format": "uint64",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    }
  },
  "description": "Explicit selection with no implicit default.",
  "oneOf": [
    {
      "properties": {
        "selection": {
          "enum": [
            "profile"
          ],
          "type": "string"
        },
        "value": {
          "$ref": "#/definitions/BudgetProfile"
        }
      },
      "required": [
        "selection",
        "value"
      ],
      "type": "object"
    },
    {
      "properties": {
        "selection": {
          "enum": [
            "custom"
          ],
          "type": "string"
        },
        "value": {
          "$ref": "#/definitions/ResourceBudget"
        }
      },
      "required": [
        "selection",
        "value"
      ],
      "type": "object"
    }
  ],
  "title": "BudgetSelection"
}
