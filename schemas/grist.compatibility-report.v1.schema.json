{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "CompatibilityChange": {
      "properties": {
        "breaking": {
          "type": "boolean"
        },
        "detail": {
          "type": "string"
        },
        "instance_path": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/definitions/CompatibilityChangeKind"
        }
      },
      "required": [
        "breaking",
        "detail",
        "instance_path",
        "kind"
      ],
      "type": "object"
    },
    "CompatibilityChangeKind": {
      "enum": [
        "optional_field_added",
        "required_field_added",
        "field_removed",
        "type_changed",
        "enum_value_added",
        "enum_value_removed",
        "meaning_changed",
        "canonicalization_changed",
        "locator_changed",
        "behavior_changed"
      ],
      "type": "string"
    }
  },
  "properties": {
    "changes": {
      "items": {
        "$ref": "#/definitions/CompatibilityChange"
      },
      "type": "array"
    },
    "compatible": {
      "type": "boolean"
    },
    "current_version": {
      "type": "string"
    },
    "previous_version": {
      "type": "string"
    },
    "requires_new_schema_version": {
      "type": "boolean"
    }
  },
  "required": [
    "changes",
    "compatible",
    "current_version",
    "previous_version",
    "requires_new_schema_version"
  ],
  "title": "CompatibilityReport",
  "type": "object"
}
