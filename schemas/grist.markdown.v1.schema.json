{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "Frontmatter": {
      "properties": {
        "range": {
          "$ref": "#/definitions/SourceRange"
        },
        "raw": {
          "type": "string"
        },
        "value": true
      },
      "required": [
        "range",
        "raw"
      ],
      "type": "object"
    },
    "MarkdownNode": {
      "properties": {
        "destination": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "info": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "$ref": "#/definitions/MarkdownNodeKind"
        },
        "language": {
          "type": [
            "string",
            "null"
          ]
        },
        "level": {
          "format": "uint8",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "range": {
          "anyOf": [
            {
              "$ref": "#/definitions/SourceRange"
            },
            {
              "type": "null"
            }
          ]
        },
        "table": {
          "anyOf": [
            {
              "$ref": "#/definitions/MarkdownTable"
            },
            {
              "type": "null"
            }
          ]
        },
        "text": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "kind"
      ],
      "type": "object"
    },
    "MarkdownNodeKind": {
      "enum": [
        "heading",
        "paragraph",
        "code_fence",
        "link",
        "table",
        "text"
      ],
      "type": "string"
    },
    "MarkdownTable": {
      "properties": {
        "alignments": {
          "description": "Alignment metadata from the delimiter row, one entry per column where available.",
          "items": {
            "$ref": "#/definitions/MarkdownTableAlignment"
          },
          "type": "array"
        },
        "row_details": {
          "description": "Structured row/cell representation with source ranges where pulldown-cmark exposes them.",
          "items": {
            "$ref": "#/definitions/MarkdownTableRow"
          },
          "type": "array"
        },
        "rows": {
          "description": "Backward-compatible plain text projection of every parsed row.",
          "items": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "type": "array"
        }
      },
      "required": [
        "alignments",
        "row_details",
        "rows"
      ],
      "type": "object"
    },
    "MarkdownTableAlignment": {
      "enum": [
        "none",
        "left",
        "center",
        "right"
      ],
      "type": "string"
    },
    "MarkdownTableCell": {
      "properties": {
        "range": {
          "anyOf": [
            {
              "$ref": "#/definitions/SourceRange"
            },
            {
              "type": "null"
            }
          ]
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "type": "object"
    },
    "MarkdownTableRow": {
      "properties": {
        "cells": {
          "items": {
            "$ref": "#/definitions/MarkdownTableCell"
          },
          "type": "array"
        },
        "header": {
          "type": "boolean"
        },
        "range": {
          "anyOf": [
            {
              "$ref": "#/definitions/SourceRange"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "cells",
        "header"
      ],
      "type": "object"
    },
    "SourceRange": {
      "properties": {
        "byte_end": {
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "byte_start": {
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "end_column": {
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "end_line": {
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "start_column": {
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "start_line": {
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "byte_end",
        "byte_start",
        "end_column",
        "end_line",
        "start_column",
        "start_line"
      ],
      "type": "object"
    }
  },
  "properties": {
    "frontmatter": {
      "anyOf": [
        {
          "$ref": "#/definitions/Frontmatter"
        },
        {
          "type": "null"
        }
      ]
    },
    "nodes": {
      "items": {
        "$ref": "#/definitions/MarkdownNode"
      },
      "type": "array"
    },
    "schema_version": {
      "type": "string"
    }
  },
  "required": [
    "nodes",
    "schema_version"
  ],
  "title": "MarkdownDocument",
  "type": "object"
}
