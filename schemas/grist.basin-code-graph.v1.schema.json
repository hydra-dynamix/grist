{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "CodeEdge": {
      "properties": {
        "dst": {
          "type": "string"
        },
        "relation": {
          "type": "string"
        },
        "src": {
          "type": "string"
        }
      },
      "required": [
        "dst",
        "relation",
        "src"
      ],
      "type": "object"
    }
  },
  "description": "A typed directed code graph used to produce basin walks.",
  "properties": {
    "edges": {
      "items": {
        "$ref": "#/definitions/CodeEdge"
      },
      "type": "array"
    },
    "module": {
      "type": "string"
    },
    "nodes": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "roots": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    }
  },
  "required": [
    "edges",
    "module",
    "nodes",
    "roots"
  ],
  "title": "CodeGraph",
  "type": "object"
}
