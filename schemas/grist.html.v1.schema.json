{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "HtmlAttribute": {
      "properties": {
        "name": {
          "type": "string"
        },
        "name_range": {
          "$ref": "#/definitions/SourceRange"
        },
        "value": {
          "type": [
            "string",
            "null"
          ]
        },
        "value_range": {
          "anyOf": [
            {
              "$ref": "#/definitions/SourceRange"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "name",
        "name_range"
      ],
      "type": "object"
    },
    "HtmlNode": {
      "properties": {
        "attributes": {
          "items": {
            "$ref": "#/definitions/HtmlAttribute"
          },
          "type": "array"
        },
        "depth": {
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "htmx_attributes": {
          "items": {
            "$ref": "#/definitions/HtmxAttribute"
          },
          "type": "array"
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/definitions/HtmlNodeKind"
        },
        "range": {
          "$ref": "#/definitions/SourceRange"
        },
        "self_closing": {
          "type": "boolean"
        },
        "tag_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "text": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "attributes",
        "depth",
        "htmx_attributes",
        "id",
        "kind",
        "range",
        "self_closing"
      ],
      "type": "object"
    },
    "HtmlNodeKind": {
      "enum": [
        "element_open",
        "element_close",
        "void_element",
        "text",
        "comment",
        "doctype"
      ],
      "type": "string"
    },
    "HtmlParseMode": {
      "enum": [
        "auto",
        "document",
        "fragment"
      ],
      "type": "string"
    },
    "HtmxAttribute": {
      "properties": {
        "element_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "normalized_name": {
          "type": "string"
        },
        "range": {
          "$ref": "#/definitions/SourceRange"
        },
        "tag_name": {
          "type": "string"
        },
        "value": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "element_id",
        "name",
        "normalized_name",
        "range",
        "tag_name"
      ],
      "type": "object"
    },
    "SourceRange": {
      "properties": {
        "byte_end": {
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "byte_start": {
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "end_column": {
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "end_line": {
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "start_column": {
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "start_line": {
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "byte_end",
        "byte_start",
        "end_column",
        "end_line",
        "start_column",
        "start_line"
      ],
      "type": "object"
    }
  },
  "properties": {
    "has_doctype": {
      "type": "boolean"
    },
    "htmx_attributes": {
      "items": {
        "$ref": "#/definitions/HtmxAttribute"
      },
      "type": "array"
    },
    "mode": {
      "$ref": "#/definitions/HtmlParseMode"
    },
    "nodes": {
      "items": {
        "$ref": "#/definitions/HtmlNode"
      },
      "type": "array"
    },
    "root_element_count": {
      "format": "uint",
      "minimum": 0.0,
      "type": "integer"
    },
    "schema_version": {
      "type": "string"
    }
  },
  "required": [
    "has_doctype",
    "htmx_attributes",
    "mode",
    "nodes",
    "root_element_count",
    "schema_version"
  ],
  "title": "HtmlDocument",
  "type": "object"
}
