{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "BoundingBox": {
      "description": "A rectangle in a declared coordinate system.",
      "properties": {
        "height": {
          "format": "double",
          "type": "number"
        },
        "origin": {
          "$ref": "#/definitions/CoordinateOrigin"
        },
        "unit": {
          "$ref": "#/definitions/CoordinateUnit"
        },
        "width": {
          "format": "double",
          "type": "number"
        },
        "x": {
          "format": "double",
          "type": "number"
        },
        "y": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "height",
        "origin",
        "unit",
        "width",
        "x",
        "y"
      ],
      "type": "object"
    },
    "CellAddress": {
      "description": "A sheet cell address with explicit row and column bases.",
      "properties": {
        "base": {
          "$ref": "#/definitions/IndexBase"
        },
        "column": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "row": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "base",
        "column",
        "row"
      ],
      "type": "object"
    },
    "CoordinateOrigin": {
      "description": "Coordinate-system origin for rectangular source regions.",
      "enum": [
        "top_left",
        "bottom_left"
      ],
      "type": "string"
    },
    "CoordinateUnit": {
      "description": "Units used by rectangular source regions.",
      "enum": [
        "points",
        "pixels",
        "normalized"
      ],
      "type": "string"
    },
    "CsvCell": {
      "properties": {
        "column_index": {
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "empty": {
          "type": "boolean"
        },
        "header": {
          "type": [
            "string",
            "null"
          ]
        },
        "locator": {
          "$ref": "#/definitions/SourceLocator"
        },
        "quote_closed": {
          "type": "boolean"
        },
        "quoted": {
          "type": "boolean"
        },
        "range": {
          "$ref": "#/definitions/SourceRange"
        },
        "raw": {
          "description": "Exact source lexeme, including quote and escape spelling.",
          "type": "string"
        },
        "text": {
          "description": "Field text after dialect-level unquoting only.",
          "type": "string"
        },
        "typed_candidates": {
          "items": {
            "$ref": "#/definitions/CsvScalarCandidate"
          },
          "type": "array"
        },
        "value": {
          "description": "Compatibility-selected scalar; `typed_candidates` is authoritative."
        },
        "value_range": {
          "$ref": "#/definitions/SourceRange"
        }
      },
      "required": [
        "column_index",
        "empty",
        "locator",
        "quote_closed",
        "quoted",
        "range",
        "raw",
        "text",
        "typed_candidates",
        "value",
        "value_range"
      ],
      "type": "object"
    },
    "CsvDelimiter": {
      "enum": [
        "auto",
        "comma",
        "tab",
        "semicolon",
        "pipe"
      ],
      "type": "string"
    },
    "CsvDialect": {
      "properties": {
        "candidates": {
          "items": {
            "$ref": "#/definitions/CsvDialectCandidate"
          },
          "type": "array"
        },
        "delimiter": {
          "$ref": "#/definitions/CsvDelimiter"
        },
        "delimiter_text": {
          "type": "string"
        },
        "double_quote": {
          "type": "boolean"
        },
        "escape": {
          "type": [
            "string",
            "null"
          ]
        },
        "quote": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "$ref": "#/definitions/CsvDialectSource"
        }
      },
      "required": [
        "candidates",
        "delimiter",
        "delimiter_text",
        "double_quote",
        "source"
      ],
      "type": "object"
    },
    "CsvDialectCandidate": {
      "properties": {
        "consistent_records": {
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "delimiter": {
          "$ref": "#/definitions/CsvDelimiter"
        },
        "malformed_records": {
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "modal_width": {
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "sampled_records": {
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "score": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "consistent_records",
        "delimiter",
        "malformed_records",
        "modal_width",
        "sampled_records",
        "score"
      ],
      "type": "object"
    },
    "CsvDialectSource": {
      "enum": [
        "detected",
        "declared"
      ],
      "type": "string"
    },
    "CsvHeader": {
      "properties": {
        "column_index": {
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "locator": {
          "$ref": "#/definitions/SourceLocator"
        },
        "name": {
          "type": "string"
        },
        "quoted": {
          "type": "boolean"
        },
        "range": {
          "$ref": "#/definitions/SourceRange"
        },
        "raw": {
          "type": "string"
        }
      },
      "required": [
        "column_index",
        "locator",
        "name",
        "quoted",
        "range",
        "raw"
      ],
      "type": "object"
    },
    "CsvNewlineFidelity": {
