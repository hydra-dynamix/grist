          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "final_record_terminated": {
          "type": "boolean"
        },
        "lf_count": {
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "mixed": {
          "type": "boolean"
        }
      },
      "required": [
        "cr_count",
        "crlf_count",
        "final_record_terminated",
        "lf_count",
        "mixed"
      ],
      "type": "object"
    },
    "CsvParseIssue": {
