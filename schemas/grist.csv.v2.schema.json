              "type": "string"
            }
          },
          "required": [
            "byte_end",
            "byte_start",
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "byte_end": {
              "format": "uint",
              "minimum": 0.0,
              "type": "integer"
            },
            "byte_start": {
              "format": "uint",
              "minimum": 0.0,
              "type": "integer"
            },
            "end_column": {
              "format": "uint",
              "minimum": 0.0,
              "type": "integer"
            },
            "end_line": {
              "format": "uint",
              "minimum": 0.0,
              "type": "integer"
            },
            "start_column": {
              "format": "uint",
              "minimum": 0.0,
              "type": "integer"
            },
            "start_line": {
              "format": "uint",
              "minimum": 0.0,
              "type": "integer"
            },
            "type": {
              "enum": [
                "text_range"
