          "type": "array"
        },
        "full_range": {
          "$ref": "#/definitions/SourceRange"
        },
        "index": {
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "issues": {
          "items": {
            "$ref": "#/definitions/CsvParseIssue"
          },
          "type": "array"
        },
        "locator": {
          "$ref": "#/definitions/SourceLocator"
        },
        "malformed": {
          "type": "boolean"
        },
        "range": {
          "$ref": "#/definitions/SourceRange"
        },
        "raw": {
          "description": "Exact logical-record text, excluding its terminator.",
          "type": "string"
        },
        "role": {
          "$ref": "#/definitions/CsvRecordRole"
        },
        "source_line": {
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "source_record_index": {
          "description": "One-based logical record index, including the header.",
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "terminator": {
          "$ref": "#/definitions/CsvRecordTerminator"
        },
        "width": {
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "cells",
        "full_range",
        "index",
        "issues",
        "locator",
        "malformed",
        "range",
        "raw",
        "role",
        "source_line",
        "source_record_index",
        "terminator",
        "width"
      ],
      "type": "object"
    },
    "CsvScalarCandidate": {
      "properties": {
        "confidence": {
          "format": "double",
          "type": "number"
        },
        "evidence": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/definitions/CsvScalarKind"
        },
        "normalized": {
          "type": "boolean"
        },
        "value": true
      },
      "required": [
        "confidence",
        "evidence",
        "kind",
        "normalized",
        "value"
      ],
      "type": "object"
    },
    "CsvScalarKind": {
      "enum": [
        "null",
        "boolean",
        "integer",
        "decimal",
        "date",
        "date_time",
        "text"
      ],
      "type": "string"
    },
    "DerivedNodeReference": {
      "description": "A reference from derived content back to the nodes and declared transforms that produced it.",
      "properties": {
        "derivation_steps": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "source_node_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "derivation_steps",
        "source_node_ids"
      ],
      "type": "object"
    },
    "IndexBase": {
      "description": "Whether an ordinal is counted from zero or one.\n\nEvery format component carrying a page, slide, cell, frame, token, output, member, track, or record ordinal uses this type rather than relying on an undocumented convention.",
      "enum": [
        "zero",
        "one"
      ],
      "type": "string"
    },
    "IndexPosition": {
      "description": "One explicitly based ordinal.",
      "properties": {
        "base": {
          "$ref": "#/definitions/IndexBase"
        },
        "value": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "base",
        "value"
      ],
      "type": "object"
    },
    "IndexRange": {
      "description": "A half-open range of ordinals using one declared base.",
      "properties": {
        "base": {
          "$ref": "#/definitions/IndexBase"
        },
        "end": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
