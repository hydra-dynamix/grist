            },
            "row": {
              "anyOf": [
                {
                  "$ref": "#/definitions/IndexPosition"
                },
                {
                  "type": "null"
                }
              ]
            },
            "run": {
              "anyOf": [
                {
                  "$ref": "#/definitions/IndexPosition"
                },
                {
                  "type": "null"
                }
              ]
            },
            "table": {
              "anyOf": [
                {
                  "$ref": "#/definitions/IndexPosition"
                },
                {
                  "type": "null"
                }
