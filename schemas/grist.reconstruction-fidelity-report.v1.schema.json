{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "ReconstructionDifference": {
      "properties": {
        "affected_node_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "affected_package_parts": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "kind": {
          "$ref": "#/definitions/ReconstructionDifferenceKind"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "message"
      ],
      "type": "object"
    },
    "ReconstructionDifferenceKind": {
      "enum": [
        "content",
        "structure",
        "formatting",
        "metadata",
        "ordering",
        "packaging"
      ],
      "type": "string"
    },
    "ReconstructionFidelity": {
      "enum": [
        "lossy",
        "semantic_equivalent",
        "package_equivalent",
        "byte_identical"
      ],
      "type": "string"
    },
    "ReconstructionFixtureEvidence": {
      "properties": {
        "expected_package_sha256": {
          "type": "string"
        },
        "fixture_id": {
          "type": "string"
        },
        "input_sha256": {
          "type": "string"
        },
        "verified_fidelity": {
          "$ref": "#/definitions/ReconstructionFidelity"
        }
      },
      "required": [
        "expected_package_sha256",
        "fixture_id",
        "input_sha256",
        "verified_fidelity"
      ],
      "type": "object"
    }
  },
  "properties": {
    "achieved_fidelity": {
      "$ref": "#/definitions/ReconstructionFidelity"
    },
    "differences": {
      "default": [],
      "items": {
        "$ref": "#/definitions/ReconstructionDifference"
      },
      "type": "array"
    },
    "fixture_evidence": {
      "items": {
        "$ref": "#/definitions/ReconstructionFixtureEvidence"
      },
      "minItems": 1,
      "type": "array"
    },
    "format": {
      "type": "string"
    },
    "implementation": {
      "type": "string"
    },
    "implementation_version": {
      "type": "string"
    },
    "media_type": {
      "type": "string"
    },
    "package_profile": {
      "type": "string"
    },
    "requested_fidelity": {
      "$ref": "#/definitions/ReconstructionFidelity"
    },
    "schema_version": {
      "type": "string"
    },
    "verification": {
      "type": "string"
    }
  },
  "required": [
    "achieved_fidelity",
    "fixture_evidence",
    "format",
    "implementation",
    "implementation_version",
    "media_type",
    "package_profile",
    "requested_fidelity",
    "schema_version",
    "verification"
  ],
  "title": "ReconstructionFidelityReport",
  "type": "object"
}
